{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@spartan-ng/helm/button": [
        "./src/app/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./src/app/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./src/app/ui/input/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "./src/app/ui/select/src/index.ts"
      ],
      "@spartan-ng/helm/checkbox": [
        "./src/app/ui/checkbox/src/index.ts"
      ],
      "@spartan-ng/helm/switch": [
        "./src/app/ui/switch/src/index.ts"
      ],
      "@spartan-ng/helm/dialog": [
        "./src/app/ui/dialog/src/index.ts"
      ],
      "@spartan-ng/helm/popover": [
        "./src/app/ui/popover/src/index.ts"
      ],
      "@spartan-ng/helm/tabs": [
        "./src/app/ui/tabs/src/index.ts"
      ],
      "@spartan-ng/helm/table": [
        "./src/app/ui/table/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./src/app/ui/skeleton/src/index.ts"
      ],
      "@spartan-ng/helm/badge": [
        "./src/app/ui/badge/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./src/app/ui/card/src/index.ts"
      ],
      "@spartan-ng/helm/sonner": [
        "./src/app/ui/sonner/src/index.ts"
      ],
      "@spartan-ng/helm/tooltip": [
        "./src/app/ui/tooltip/src/index.ts"
      ],
      "@spartan-ng/helm/native-select": [
        "./src/app/ui/native-select/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
